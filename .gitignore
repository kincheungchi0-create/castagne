
# Godot-specific ignores
.import/
export.cfg
export_presets.cfg

# Mono-specific ignores
.mono/
data_*/

# ------------------
# Castagne specific

# Upstream keeps bundled art out of git (build script adds it). Root /assets only,
# with an exception for this fork's Anime Girl fighter pack.
/assets/*
!/assets/fighters/
/assets/fighters/*
!/assets/fighters/animegirl/
!/assets/fighters/animegirl/**

# Nested tutorial assets stay out of git (same as upstream "assets" ignore intent)
editor/tutorials/assets/

# Release-specific; added by upstream build script
castagne-version.json

# Keep Godot HTML5 web export (index.html / .js / .wasm / .pck) in git for Vercel
!/web/
!/web/**

# Vercel local link
.vercel/
web/.vercel/
web/.env.local
